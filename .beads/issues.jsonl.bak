{"id":"bw-h9x.3","title":"TypeScript interfaces for Beads/bv data models","description":"Create lib/types.ts with TypeScript interfaces for all bv robot protocol JSON responses: RobotInsights, RobotPlan, RobotPriority, RobotDiff, RobotRecipes. Also BeadsIssue interface matching .beads/issues.jsonl schema.","status":"closed","priority":0,"issue_type":"task","owner":"janemckay@me.com","created_at":"2026-02-08T18:47:12Z","created_by":"Jane McKay","updated_at":"2026-02-08T22:57:43Z","closed_at":"2026-02-08T22:57:43Z","labels":["phase1","types"],"dependencies":[{"issue_id":"bw-h9x.3","depends_on_id":"bw-h9x","type":"parent-child","created_at":"2026-02-08T18:47:12Z","created_by":"Jane McKay","metadata":"{}"}],"dependency_count":0,"dependent_count":0,"comment_count":0}
