# Required: path to a Beads-enabled git repository
BEADS_PROJECT_PATH=/path/to/your/beads-enabled/project

# Optional: explicit path to bv binary (if not on PATH)
BV_PATH=

# Optional: polling interval in ms (default 30000)
POLL_INTERVAL_MS=30000

# Optional: Anthropic API key for AI title cleanup on quick-create
# Without this, bead titles are saved as-is (no cleanup)
ANTHROPIC_API_KEY=

# Optional: Langfuse tracing (observability for LLM calls)
# Get keys from Langfuse UI -> Settings -> API Keys
# Without these, tracing is silently disabled
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: Langfuse project ID for "View in Langfuse" dashboard links
# Get from Langfuse UI -> Settings -> General -> Project ID
LANGFUSE_PROJECT_ID=
